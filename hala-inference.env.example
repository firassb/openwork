# ============================================================
# OpenWork HALA — inference service environment
# (copy to ee/apps/inference/.env)
# ============================================================

PORT=8791

# MySQL — same DB as den-api
DATABASE_URL=mysql://openwork:CHANGE_ME@mysql:3306/openwork_den
DEN_DB_ENCRYPTION_KEY=REPLACE_WITH_SAME_KEY_AS_DEN_API

# --- GROQ DIRECT INTEGRATION (DEPRECATED 2026-07-23) ---
# Groq partnership has ended and Groq is no longer a supplier. Do not point
# OPENROUTER_UPSTREAM_URL at Groq for new deployments. Kept here for reference
# only until the OCI self-hosted stack below replaces it.
# OPENROUTER_UPSTREAM_URL=https://api.groq.com/openai/v1
# Note: your Groq API key was stored per-org in the DB (InferenceOrgUpstreamProviderKeyTable),
# not in this env file.

# --- OCI SELF-HOSTED (PLANNED) ---
# HALA is deploying its own models on OCI GPUs. Fill these in once the
# self-hosted inference endpoint exists, then set OPENROUTER_UPSTREAM_URL to it.
# OCI_INFERENCE_UPSTREAM_URL=https://TBD.oci.hala.internal/v1
# OPENROUTER_UPSTREAM_URL=${OCI_INFERENCE_UPSTREAM_URL}

# Public base URL of this inference service (used in request headers)
INFERENCE_PROXY_BASE_URL=https://openwork.hala.com

# Admin token for inference management endpoints — generate securely
INFERENCE_ADMIN_TOKEN=REPLACE_WITH_SECURE_RANDOM_TOKEN

# Webhook secret for usage callbacks
INFERENCE_WEBHOOK_SECRET=REPLACE_WITH_SECURE_RANDOM_TOKEN

# Credits per dollar — set to 1 for internal (no billing)
INFERENCE_CREDITS_PER_DOLLAR=1000000

CORS_ORIGINS=https://openwork.hala.com
