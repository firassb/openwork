# ============================================================
# OpenWork HALA — den-api environment (copy to ee/apps/den-api/.env)
# ============================================================

PORT=8788
CORS_ORIGINS=https://openwork.hala.com

# MySQL — internal on-prem database
DATABASE_URL=mysql://openwork:CHANGE_ME@mysql:3306/openwork_den

# Auth secrets — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=REPLACE_WITH_GENERATED_SECRET_MIN_32_CHARS
DEN_DB_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_KEY_MIN_32_CHARS

# Public URL of the den-api service
BETTER_AUTH_URL=https://openwork.hala.com
DEN_BETTER_AUTH_TRUSTED_ORIGINS=https://openwork.hala.com

# Email — use your internal SMTP relay
EMAIL_FROM=OpenWork HALA <no-reply@hala.com>
SMTP_HOST=smtp.hala.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Leave RESEND_API_KEY blank to use SMTP instead of Resend
RESEND_API_KEY=

# Inference proxy URL (points to internal inference service)
INFERENCE_PROXY_BASE_URL=http://inference:8791

# Worker provisioning — set to 'local' for on-prem (no Daytona/Render/Vercel)
PROVISIONER_MODE=local
WORKER_URL_TEMPLATE=https://workers.hala.com/{workerId}
WORKER_ACTIVITY_BASE_URL=https://openwork.hala.com

# Billing — disable Stripe and Polar for internal use
POLAR_FEATURE_GATE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Disable cloud integrations not needed internally
RENDER_API_KEY=
VERCEL_TOKEN=
DAYTONA_API_KEY=
DAYTONA_API_URL=
LOOPS_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_WORKSPACE_ID=

# Dev mode — set to 0 in production
OPENWORK_DEV_MODE=0
